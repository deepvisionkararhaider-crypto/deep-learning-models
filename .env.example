# Copy to `.env` for local training/publishing, or set these in the environment.
# NEVER commit a real token. `.env` and `.streamlit/secrets.toml` are gitignored.

# --- Hugging Face artifact storage -------------------------------------------
# Where trained checkpoints live. Also set as a GitHub Actions *variable*.
HF_MODEL_REPO=KararDeepVision/deep-learning-models

# Write token used ONLY by training/publishing (upload) — never by the app.
# Create a fine-grained token with "write" access to the model repo above:
#   https://huggingface.co/settings/tokens
# Required scopes: repo write (model). Do not grant anything else.
# In GitHub: Settings -> Secrets and variables -> Actions -> Secrets -> HF_TOKEN
HF_TOKEN=

# --- Optional overrides ------------------------------------------------------
# Where downloaded artifacts are cached locally (default: ~/.cache/dl-models-hf).
# HF_ARTIFACT_CACHE=/tmp/dl-models-hf

# Pin downloads to an immutable revision instead of the default branch.
# HF_REVISION=

# Streamlit (local dev only; Community Cloud injects its own secrets).
# HF_MODEL_REPO can also be provided via .streamlit/secrets.toml.
